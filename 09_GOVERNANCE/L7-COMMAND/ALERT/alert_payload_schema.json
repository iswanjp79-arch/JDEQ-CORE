{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "alert_payload",
  "type": "object",
  "properties": {
    "id": {"type":"string"},
    "severity": {"type":"string","enum":["CRITICAL","HIGH","MEDIUM","LOW","INFO"]},
    "source": {"type":"string"},
    "message": {"type":"string"},
    "timestamp": {"type":"string","format":"date-time"}
  },
  "required": ["id","severity","source","message","timestamp"]
}

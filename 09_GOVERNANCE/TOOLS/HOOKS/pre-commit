#!/bin/sh
# MICO-JDEQ Governance Guard v6 (pre-commit)
# Rule 1: perubahan file ATURAN wajib disertai ADR/V.21
# Whitelist: tools, drafts, handover, manifest, evidence

STAGED=$(git diff --cached --name-only)

# File yang TIDAK butuh referensi ADR (tools, drafts, manifest, dll)
NO_ADR_NEEDED="TOOLS/|DECREE/|LAPORAN|P2-ARCH-EVAL|P2-DESIGN|P1-PLANNING/.*DRAFT|P1-PLANNING/HANDOVER|HANDOFF_|README|exception-log|AUDIT-ANCHOR|ANCHOR-MANIFEST|KEY-FILES-MANIFEST|MONUMENT-LATEST|MONUMENT-BUILD|P1-PLANNING-INDEX|MASTER-PLAN-v1.0-MANIFEST|P1-EXECUTION|P1-FINAL-REPORT|P1-REPORTS|BEHAVIOR-CONTRACT"

NEED_ADR=""
for f in $STAGED; do
    echo "$f" | grep -q "^09_GOVERNANCE/" || continue
    echo "$f" | grep -qE "$NO_ADR_NEEDED" && continue
    NEED_ADR="yes"
    break
done

if [ -n "$NEED_ADR" ]; then
    if ! echo "$STAGED" | grep -qE "ADR-|MICO-P1-DEL03|CETAK-BIRU-V21"; then
        echo "[GOVERNANCE-GUARD] File aturan 09_GOVERNANCE tanpa ADR/V.21 di staged."
        echo "  File di staged:"
        echo "$STAGED" | sed 's/^/    /'
        echo "  Solusi: sertakan file ADR-* atau V.21, atau whitelist file manifest."
        exit 1
    fi
fi

# Rule 2: blokir backup/archive
if echo "$STAGED" | grep -qE "^(99_ARCHIVE|TREE_L/12_BACKUP)"; then
    echo "[GOVERNANCE-GUARD] Commit menyentuh arsip/backup. Tolak."
    exit 1
fi

exit 0
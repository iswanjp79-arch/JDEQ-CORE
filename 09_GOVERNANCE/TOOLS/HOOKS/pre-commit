#!/bin/sh
# MICO-JDEQ Governance Guard v4 (pre-commit — no commit message access)
STAGED=$(git diff --cached --name-only)

# Rule 1: governance tanpa ADR/V.21
if echo "$STAGED" | grep -q "^09_GOVERNANCE/"; then
    if ! echo "$STAGED" | grep -qE "ADR-|MICO-P1-DEL03|CETAK-BIRU-V21|AUDIT-ANCHOR|ANCHOR-MANIFEST"; then
        echo "[GOVERNANCE-GUARD] Perubahan 09_GOVERNANCE tanpa ADR/V.21."
        exit 1
    fi
fi

# Rule 2: blokir backup/archive
if echo "$STAGED" | grep -qE "^(99_ARCHIVE|TREE_L/12_BACKUP)"; then
    echo "[GOVERNANCE-GUARD] Commit menyentuh arsip/backup. Tolak."
    exit 1
fi

exit 0
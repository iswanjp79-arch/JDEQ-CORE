#!/bin/sh
# MICO-JDEQ Terminology Guard v2 (commit-msg)
# Baca istilah deprecated dari file config, bukan hardcoded string search.
# DOLA = canonical (2026-09-15). Lihat ADR-005-REV1 §5.

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE" 2>/dev/null)
DEPRECATED_FILE="09_GOVERNANCE/TOOLS/HOOKS/deprecated-terms.txt"

# Whitelist file (skip check)
WHITELIST="DECREE/|AGENT_ERRORS|AUDIT-ANCHOR|ANCHOR-MANIFEST|TOOLS/HOOKS|exception-log"

# Jika commit message ada LEGACY_OK → lolos
if echo "$COMMIT_MSG" | grep -q "LEGACY_OK"; then
    exit 0
fi

# Jika file config tidak ada → tidak ada istilah deprecated → lolos
if [ ! -f "$DEPRECATED_FILE" ]; then
    exit 0
fi

# Cek file yang ditambahkan
STAGED=$(git diff --cached --name-only)
for f in $STAGED; do
    case "$f" in
        *.md|*.yml|*.yaml|*.ps1|*.sh) ;;
        *) continue ;;
    esac
    echo "$f" | grep -qE "$WHITELIST" && continue

    # Loop istilah deprecated dari config
    while IFS= read -r term; do
        case "$term" in ""|\#*) continue ;; esac
        if git diff --cached -- "$f" 2>/dev/null | grep -q "^+.*\b$term\b"; then
            echo "[TERM-GUARD] File '$f' menyebut istilah deprecated: '$term'"
            echo "  Tambahkan 'LEGACY_OK' di commit message jika memang disengaja."
            exit 1
        fi
    done < "$DEPRECATED_FILE"
done

exit 0
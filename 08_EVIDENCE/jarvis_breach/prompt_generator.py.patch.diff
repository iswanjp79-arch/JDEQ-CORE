+import sys
+
+def sanitize_boundary(text: str) -> str:
+    """
+    Netralkan karakter pembatas tag (< >) sehingga input tidak dapat
+    memecah struktur XML-like. Data tetap dibaca sebagai data.
+    Bukan blacklist kata. Bukan security control tunggal.
+    """
+    if text is None:
+        return ""
+    s = str(text)
+    s = s.replace("<", "&lt;").replace(">", "&gt;")
+    if len(s) > 8000:
+        s = s[:8000]
+    return s
+
+def generate_prompt(user_input: str) -> str:
+    safe_input = sanitize_boundary(user_input)
